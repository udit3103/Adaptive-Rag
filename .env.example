# Required for LLM responses and document embeddings.
OPENAI_API_KEY=

# Required only for queries routed to web search.
TAVILY_API_KEY=

# Set the same random value in local API and Vercel server environments.
RAG_API_TOKEN=

# Qdrant Cloud (or another persistent Qdrant instance) stores document vectors.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=adaptive-rag-documents

# Chat history defaults to memory; MongoDB can be enabled separately.
CHAT_HISTORY_BACKEND=memory
MONGODB_URL=
MONGODB_DB_NAME=adaptive_rag

# Next.js server-side proxy points to the FastAPI backend.
RAG_API_URL=http://127.0.0.1:8000
