# Required for LLM responses and document embeddings.
OPENAI_API_KEY=

# Required only for queries routed to web search.
TAVILY_API_KEY=

# Chat history defaults to memory, so no database is required for local use.
# Set to "mongodb" and configure MONGODB_URL to enable MongoDB history.
CHAT_HISTORY_BACKEND=memory
MONGODB_URL=
MONGODB_DB_NAME=adaptive_rag

# Streamlit uses this URL to connect to the FastAPI backend.
RAG_API_URL=http://127.0.0.1:8000
